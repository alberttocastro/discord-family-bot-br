# ==========================================
# Discord Bot - Configurações de Ambiente
# ==========================================

# Ambiente de execução: development | production | test
NODE_ENV=development

# Porta HTTP (Google Cloud Run injeta automaticamente 8080)
PORT=8080

# Credenciais do Discord (https://discord.com/developers/applications)
# Obrigatório: Token do Bot
DISCORD_TOKEN=seu_bot_token_aqui

# Opcional (Recomendado para registro de Slash Commands)
DISCORD_CLIENT_ID=seu_client_id_aqui
DISCORD_GUILD_ID=seu_servidor_guild_id_aqui

# ==========================================
# Roteamento por Canais (IDs do Discord)
# ==========================================
CHANNEL_FINANCEIRO_ID=
CHANNEL_COMPRAS_ID=
CHANNEL_NOTAS_FISCAIS_ID=
CHANNEL_COMPROMISSOS_ID=
CHANNEL_CARRO_ID=
FORUM_VIAGENS_ID=

# ==========================================
# Segurança do Google Cloud Scheduler (Cron)
# ==========================================
# Chave secreta para autorizar chamadas HTTP em /api/cron/:job
CRON_SECRET=gere_uma_chave_secreta_aleatoria

# ==========================================
# Integração Google Drive & Google Sheets
# ==========================================
# Credenciais da Service Account do Google Cloud (com APIs do Drive e Sheets ativadas)
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-service-account@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da Planilha do Google Sheets (onde os itens serão adicionados em linhas)
GOOGLE_SHEETS_SPREADSHEET_ID=

# ID da Pasta do Google Drive (onde arquivos de comprovante .md serão salvos)
GOOGLE_DRIVE_FOLDER_ID=
